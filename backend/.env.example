DATABASE_URL="postgresql://user:password@localhost:5432/electronics_store"
# Only needed when DATABASE_URL is a pooled connection (e.g. Neon's pooler
# endpoint) — Prisma Migrate uses this direct connection instead, since
# connection poolers don't support the session-level features migrations
# need. Same value as DATABASE_URL if you're not using a pooler.
DIRECT_URL="postgresql://user:password@localhost:5432/electronics_store"
JWT_SECRET="replace-with-a-long-random-string"
PAYSTACK_SECRET_KEY="sk_test_xxx"
PORT=4000
CLIENT_URL="http://localhost:5173"

# Product image uploads (see middleware/upload.js) — from your Cloudinary
# dashboard: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# Email notifications (order confirmation / status updates)
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="apikey"
SMTP_PASS="your-smtp-password"
MAIL_FROM="no-reply@electronics-store.example"
